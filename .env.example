# Copy to .env next to docker-compose.yml and fill in what you use. Empty = that feature is off.
# .env is git-ignored. In the GitHub Actions deploy these come from repo secrets and variables.
# Keep comments on their own lines: text after a value becomes part of it.

# ---------------------------------------------------------------- basics
# Shown in the header and the browser tab
DASHBOARD_NAME=homelab
# Port on the host
DASHBOARD_PORT=3000
# Time zone, e.g. Asia/Kolkata or Europe/Berlin
TZ=UTC
# How your phone reaches the dashboard (phone alerts open this link)
DASHBOARD_PUBLIC_URL=http://192.168.1.10:3000
# SECRET, optional. If set, the Ignore/Mute buttons ask for it. Empty = anyone who can open the dashboard may use them
DASHBOARD_ADMIN_PIN=
# Comma-separated container names that are stopped on purpose
IGNORE_STOPPED_CONTAINERS=

# ---------------------------------------------------------------- phone alerts (ntfy)
# e.g. http://192.168.1.10:8085
NTFY_URL=
# SECRET. tk_... access token of an ntfy user that may publish to NTFY_TOPIC
NTFY_TOKEN=
NTFY_TOPIC=server-alerts

# ---------------------------------------------------------------- Immich
# e.g. http://192.168.1.10:2283
IMMICH_URL=
# SECRET
IMMICH_API_KEY=

# ---------------------------------------------------------------- GitHub runner + last deploy
# Organisation that owns the self-hosted runner
DASH_GITHUB_ORG=
# Runner name (empty = the first runner)
DASH_GITHUB_RUNNER=
# SECRET. Fine-grained, read-only token
DASH_GITHUB_TOKEN=

# ---------------------------------------------------------------- energy tracker (Power, Internet usage)
# Folder on the host that holds energy_tracker.db and live.json
ENERGY_DIR=/opt/energy-tracker
RATE_INR_PER_KWH=5
